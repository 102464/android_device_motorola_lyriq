type apanic, domain;
init_daemon_domain(apanic)

allow apanic apanic_exec:file { entrypoint execute getattr map open read };
allow apanic bllogs_block_device:blk_file { getattr ioctl lock map open read watch watch_reads };
allow apanic block_device:dir { search };
allow apanic expdb_block_device:blk_file { getattr ioctl lock map open read watch watch_reads };
allow apanic init:unix_stream_socket { connectto };
allow apanic kernel:system { syslog_read };
allow apanic kpan_block_device:blk_file { append getattr ioctl lock map open read watch watch_reads write };
allow apanic kpgather:process { rlimitinh siginh };
allow apanic kpgather:process { transition };
allow apanic kpgather_exec:file { execute getattr map open read };
allow apanic panic_data_file:dir { add_name getattr ioctl lock open read remove_name search watch watch_reads write };
allow apanic panic_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow apanic powerctl_prop:file { getattr map open read };
allow apanic powerctl_prop:property_service { set };
allow apanic proc:file { append getattr ioctl lock map open read watch watch_reads write };
allow apanic proc_bootinfo:file { getattr ioctl lock map open read watch watch_reads };
allow apanic proc_version:dir { getattr ioctl lock open read search watch watch_reads };
allow apanic proc_version:file { getattr ioctl lock map open read watch watch_reads };
allow apanic proc_version:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow apanic property_socket:sock_file { write };
allow apanic pstorefs:dir { add_name getattr ioctl lock open read remove_name search watch watch_reads write };
allow apanic pstorefs:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow apanic self:capability { chown fsetid };
allow apanic self:capability { setgid setuid };
allow apanic sysfs_ram:dir { getattr ioctl lock open read search watch watch_reads };
allow apanic sysfs_ram:file { getattr ioctl lock map open read watch watch_reads };
allow apanic sysfs_storage:dir { getattr ioctl lock open read search watch watch_reads };
allow apanic sysfs_storage:file { getattr ioctl lock map open read watch watch_reads };
allow apanic vendor_dropbox_data_file:dir { add_name getattr ioctl lock open read remove_name search watch watch_reads write };
allow apanic vendor_dropbox_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow apanic vendor_file:file { execute_no_trans };
allow apanic vendor_mot_boot_prop:file { getattr map open read };
allow apanic vendor_mot_init_prop:file { getattr map open read };
allow apanic vendor_mot_init_prop:property_service { set };
allow apanic vendor_shell_exec:file { getattr ioctl lock map open read watch watch_reads };
allow apanic vendor_toolbox_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow init apanic:process transition;
