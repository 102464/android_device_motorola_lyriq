# vendor_init rules ported from stock vendor_sepolicy.cil
allow vendor_init block_device:lnk_file { setattr };
allow vendor_init cache_block_device:blk_file { append getattr ioctl lock map open read watch watch_reads write };
allow vendor_init debugfs_tracing:file { append getattr ioctl lock map open read watch watch_reads write };
allow vendor_init debugfs_tracing_debug:file { append lock map open write };
allow vendor_init debugfs_tracing_instances:dir { add_name create getattr ioctl lock open read remove_name rename reparent rmdir search setattr watch watch_reads write };
allow vendor_init debugfs_tracing_instances:file { append lock map open write };
allow vendor_init expdb_block_device:blk_file { append getattr ioctl lock map open read watch watch_reads write };
allow vendor_init kernel:key { search };
allow vendor_init kmsg_device:chr_file { unlink };
allow vendor_init nfc_device:chr_file { getattr };
allow vendor_init oemfs:dir { mounton search };
allow vendor_init proc_bootprof:file { append lock map open write };
allow vendor_init proc_conninfradbg:file { append lock map open write };
allow vendor_init proc_cpufreq:file { append lock map open write };
allow vendor_init proc_cpuidle:file { append getattr ioctl lock map open read watch watch_reads write };
allow vendor_init proc_dirty:file { append lock map open write };
allow vendor_init proc_drop_caches:file { append lock map open write };
allow vendor_init proc_extra_free_kbytes:file { append lock map open write };
allow vendor_init proc_hostname:file { append lock map open write };
allow vendor_init proc_hps:file { append lock map open write };
allow vendor_init proc_hwconf:dir { search setattr };
allow vendor_init proc_hwconf:file { append getattr ioctl lock map open read setattr watch watch_reads write };
allow vendor_init proc_mtprintk:file { append lock map open write };
allow vendor_init proc_panic_on_rcu_stall:file { append getattr ioctl lock map open read watch watch_reads write };
allow vendor_init proc_perfmgr:file { append lock map open write };
allow vendor_init proc_pl_lk:file { append lock map open write };
allow vendor_init proc_sched:file { append lock map open write };
allow vendor_init proc_sched_migration_cost_ns:file { append getattr ioctl lock map open read watch watch_reads write };
allow vendor_init proc_swappiness:file { append lock map open write };
allow vendor_init proc_usb_plat:dir { search };
allow vendor_init proc_usb_plat:file { append getattr ioctl lock map open read watch watch_reads write };
allow vendor_init proc_watermark_scale_factor:file { append lock map open write };
allow vendor_init proc_wmtdbg:file { append lock map open write };
allow vendor_init proc_wmtuserproc:file { append lock map open write };
allow vendor_init procfs_blockio:file { append lock map open write };
allow vendor_init pstorefs:dir { mounton };
allow vendor_init rootfs:dir { add_name create getattr ioctl lock open read remove_name rename reparent rmdir search setattr watch watch_reads write };
allow vendor_init secure_element_device:chr_file { getattr };
allow vendor_init nfc_device:chr_file { getattr };
allow vendor_init tmpfs:dir { add_name create getattr ioctl lock open read remove_name rename reparent rmdir search setattr watch watch_reads write };
allow vendor_init tmpfs:lnk_file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow vendor_init unlabeled:dir { getattr relabelfrom search setattr };
allow vendor_init userdata_block_device:blk_file { append getattr ioctl lock map open read watch watch_reads write };
allow vendor_init vendor_audio_prop:file { getattr map open read };
allow vendor_init vendor_audio_prop:property_service { set };
allow vendor_init vendor_file:system { module_load };
allow vendor_init vendor_mot_aplogd_prop:file { getattr map open read };
allow vendor_init vendor_mot_aplogd_prop:property_service { set };
allow vendor_init vendor_mot_boot_prop:file { getattr map open read };
allow vendor_init vendor_mot_boot_prop:property_service { set };
allow vendor_init vendor_mot_hw_boardversion_prop:file { getattr map open read };
allow vendor_init vendor_mot_hw_boardversion_prop:property_service { set };
allow vendor_init vendor_mot_hw_prop:file { getattr map open read };
allow vendor_init vendor_mot_hw_prop:property_service { set };
allow vendor_init vendor_mot_init_prop:file { getattr map open read };
allow vendor_init vendor_mot_init_prop:property_service { set };
allow vendor_init vendor_mot_nfc_prop:file { getattr map open read };
allow vendor_init vendor_mot_nfc_prop:property_service { set };
allow vendor_init vendor_mot_paramfile_prop:file { getattr map open read };
allow vendor_init vendor_mot_paramfile_prop:property_service { set };
allow vendor_init vendor_mot_product_prop:file { getattr map open read };
allow vendor_init vendor_mot_product_prop:property_service { set };
allow vendor_init vendor_mot_tcmd_prop:file { getattr map open read };
allow vendor_init vendor_mot_var_prop:file { getattr map open read };
allow vendor_init vendor_mot_var_prop:property_service { set };
allow vendor_init vendor_mtk_c2_gpu_fmt_prop:file { getattr map open read };
allow vendor_init vendor_mtk_c2_gpu_fmt_prop:property_service { set };
allow vendor_init vendor_mtk_lbs_prop:file { getattr map open read };
allow vendor_init vendor_mtk_lbs_prop:property_service { set };
allow vendor_init vendor_mtk_mbrain_support_prop:file { getattr map open read };
allow vendor_init vendor_mtk_mbrain_support_prop:property_service { set };
allow vendor_init vendor_mtk_powerhal_prop:file { getattr map open read };
allow vendor_init vendor_mtk_powerhal_prop:property_service { set };
allow vendor_init vendor_sysfs_battery_supply:lnk_file { read };
