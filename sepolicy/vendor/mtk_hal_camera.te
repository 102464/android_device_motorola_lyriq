# lyriq additions for mtk_hal_camera (domain declared in device/mediatek)

allow mtk_hal_camera sysfs_therm:dir { search };
allow mtk_hal_camera sysfs_therm:file { getattr open read };

# MTK camera sub-services are labeled hal_camera_service in the MTK tree
allow mtk_hal_camera hal_camera_service:service_manager { add find };

allow mtk_hal_camera persist_camera_file:dir { search };
allow mtk_hal_camera persist_camera_file:file { getattr open read setattr };
allow mtk_hal_camera persist_data_file:dir { search };
allow hal_camera imager_data_file:dir { add_name getattr ioctl lock open read remove_name search watch watch_reads write };
allow hal_camera imager_data_file:file { append getattr ioctl lock map open read watch watch_reads write };
allow hal_camera imager_metadata_file:dir { add_name getattr ioctl lock open read remove_name search watch watch_reads write };
allow hal_camera imager_metadata_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };

hal_client_domain(mtk_hal_camera, hal_mtk_power)
allow mtk_hal_camera fwk_sensor_service:service_manager { find };
