type batt_health, domain;
init_daemon_domain(batt_health)

allow batt_health batt_health_exec:file { entrypoint execute getattr map open read };
allow batt_health kpoc_sysfs:file { getattr ioctl lock map open read watch watch_reads };
allow batt_health persist_batt_file:dir { add_name getattr ioctl lock open read remove_name search watch watch_reads write };
allow batt_health persist_batt_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow batt_health persist_data_file:dir { getattr ioctl lock open read search watch watch_reads };
allow batt_health persist_data_file:file { getattr ioctl lock map open read watch watch_reads };
allow batt_health persist_data_file:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow batt_health proc_hwconf:dir { search };
allow batt_health proc_hwconf:file { append getattr ioctl lock map open read watch watch_reads write };
allow batt_health self:netlink_kobject_uevent_socket { append bind connect create getattr getopt lock map read setattr setopt shutdown write };
allow batt_health sysfs_batteryinfo:dir { getattr ioctl lock open read search watch watch_reads };
allow batt_health sysfs_batteryinfo:file { append getattr ioctl lock map open read watch watch_reads write };
allow batt_health sysfs_batteryinfo:file { getattr ioctl lock map open read watch watch_reads };
allow batt_health sysfs_batteryinfo:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow batt_health sysfs_chg2_present:file { getattr ioctl lock map open read watch watch_reads };
allow batt_health sysfs_mm:dir { search };
allow batt_health sysfs_power_supply:dir { getattr ioctl lock open read search watch watch_reads };
allow batt_health sysfs_power_supply:file { getattr ioctl lock map open read watch watch_reads };
allow batt_health sysfs_power_supply:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow batt_health sysfs_thermal:dir { getattr ioctl lock open read search watch watch_reads };
allow batt_health sysfs_thermal:file { getattr ioctl lock map open read watch watch_reads };
allow batt_health sysfs_thermal:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow batt_health vendor_sysfs_battery_supply:dir { getattr ioctl lock open read search watch watch_reads };
allow batt_health vendor_sysfs_battery_supply:file { append getattr ioctl lock map open read watch watch_reads write };
allow batt_health vendor_sysfs_battery_supply:lnk_file { append getattr ioctl lock map open read watch watch_reads write };
allow batt_health vendor_sysfs_usb_supply:dir { getattr ioctl lock open read search watch watch_reads };
allow batt_health vendor_sysfs_usb_supply:file { getattr ioctl lock map open read watch watch_reads };
allow batt_health vendor_sysfs_usb_supply:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow init batt_health:process transition;
