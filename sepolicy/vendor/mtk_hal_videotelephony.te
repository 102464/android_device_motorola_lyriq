type mtk_hal_videotelephony, domain;
init_daemon_domain(mtk_hal_videotelephony)

allow init mtk_hal_videotelephony:process transition;
allow mtk_hal_videotelephony mtk_hal_videotelephony_exec:file { entrypoint execute getattr map open read };
allow mtk_hal_videotelephony mtkrild:unix_stream_socket { connectto };
allow mtk_hal_videotelephony rild:unix_stream_socket { connectto };
allow mtk_hal_videotelephony rild_oem_socket:sock_file { write };
allow mtk_hal_videotelephony servicemanager:binder { call transfer };
allow mtk_hal_videotelephony volte_imsvt1_socket:sock_file { append lock map open write };
