# Domain declared by device/mediatek/sepolicy_vndr; keep extra rules only
allow init mtk_lbs_service:process transition;
allow mtk_lbs_service agnss_proxy:unix_dgram_socket { sendto };
allow mtk_lbs_service agnss_proxy:unix_stream_socket { connectto };
allow mtk_lbs_service agpsd_socket:sock_file { write };
allow mtk_lbs_service ccci_device:chr_file { append getattr ioctl lock open read watch watch_reads write };
allow mtk_lbs_service gnss_daemon:unix_dgram_socket { sendto };
allow mtk_lbs_service gsm0710muxd_device:chr_file { append getattr ioctl lock open read watch watch_reads write };
allow mtk_lbs_service init:unix_stream_socket { connectto };
allow mtk_lbs_service mnld:unix_dgram_socket { sendto };
allow mtk_lbs_service mtk_agpsd:unix_dgram_socket { sendto };
allow mtk_lbs_service mtk_agpsd:unix_stream_socket { connectto };
allow mtk_lbs_service mtk_lbs_service_exec:file { entrypoint execute getattr map open read };

# Stock parity: GNSS HAL binder (GPS)
allow mtk_lbs_service hal_gnss_default:binder { call transfer };
allow mtk_lbs_service hal_gnss_default:fd use;
allow mtk_lbs_service mtk_wwan_device:chr_file { append getattr ioctl lock open read watch watch_reads write };
allow mtk_lbs_service property_socket:sock_file { write };
allow mtk_lbs_service self:netlink_kobject_uevent_socket { append bind connect create getattr getopt lock map read setattr setopt shutdown write };
allow mtk_lbs_service sysfs_ccci:dir { search };
allow mtk_lbs_service sysfs_ccci:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_lbs_service sysfs_wwan_fsm_state:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_lbs_service vendor_mtk_lbs_prop:file { getattr map open read };
allow mtk_lbs_service vendor_mtk_lbs_prop:property_service { set };

hal_server_domain(mtk_lbs_service, hal_mtk_lbs)
allow hal_mtk_lbs_client mtk_hal_lbs_service:service_manager find;
add_service(hal_mtk_lbs_server, mtk_hal_lbs_service)
binder_call(hal_mtk_lbs_server, servicemanager)
allow mtk_lbs_service vendor_mtk_lbs_prop:file { getattr map open read };
allow mtk_lbs_service vendor_mtk_lbs_prop:property_service { set };
