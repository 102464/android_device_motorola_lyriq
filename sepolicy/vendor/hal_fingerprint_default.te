allow hal_fingerprint_default fps_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
add_service(hal_fingerprint_server, hal_fingerprint_test_service)
# Stock parity rules sourced from the hal_fingerprint attribute
allow hal_fingerprint_default sysfs_leds:dir search;
allow hal_fingerprint_default sysfs_leds:file { append getattr ioctl lock map open read watch watch_reads write };
# Intentional: Moto apps run in system_app domain
allow hal_fingerprint_default system_app:binder { call transfer };
allow hal_fingerprint_default system_app:fd use;

# Stock parity: HAL client domains for binder/service access
hal_client_domain(hal_fingerprint_default, hal_health)
hal_client_domain(hal_fingerprint_default, hal_power)

# Stock parity: binder calls to vendor HALs and services
allow hal_fingerprint_default charger_vendor:binder { call transfer };
allow hal_fingerprint_default charger_vendor:fd use;
allow hal_fingerprint_default hal_moto_panel_default:binder { call transfer };
allow hal_fingerprint_default hal_moto_panel_default:fd use;
allow hal_fingerprint_default hal_moto_panel_aidl_service:service_manager find;
allow hal_fingerprint_default mtk_hal_power_service:service_manager find;
allow hal_fingerprint_default merged_hal_service:binder { call transfer };
allow hal_fingerprint_default merged_hal_service:fd use;
allow hal_fingerprint_default tcmd:binder { call transfer };
allow hal_fingerprint_default tcmd:fd use;
allow hal_fingerprint_default platform_app:binder { call transfer };
allow hal_fingerprint_default platform_app:fd use;
allow hal_fingerprint_default servicemanager:fd use;
allow hal_fingerprint_default hidl_manager_hwservice:hwservice_manager find;
allow hal_fingerprint_default dumpstate:fifo_file { append lock map open };
allow hal_fingerprint_default ion_device:chr_file { append write };
allow hal_fingerprint_default vendor_hal_goodix_aidl:service_manager { add find };
