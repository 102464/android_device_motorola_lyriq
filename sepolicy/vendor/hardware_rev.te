type hardware_rev, domain;
init_daemon_domain(hardware_rev)

allow hardware_rev hardware_rev_exec:file { entrypoint execute getattr map open read };
allow hardware_rev hwrev_data_file:dir { add_name create getattr ioctl lock open read remove_name rename reparent rmdir search setattr watch watch_reads write };
allow hardware_rev hwrev_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow hardware_rev sysfs:dir { getattr ioctl lock open read search watch watch_reads };
allow hardware_rev sysfs:file { getattr ioctl lock map open read watch watch_reads };
allow hardware_rev sysfs:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow hardware_rev sysfs_drm:dir { getattr ioctl lock open read search watch watch_reads };
allow hardware_rev sysfs_drm:file { getattr ioctl lock map open read watch watch_reads };
allow hardware_rev sysfs_drm:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow hardware_rev sysfs_graphics:dir { getattr ioctl lock open read search watch watch_reads };
allow hardware_rev sysfs_graphics:file { getattr ioctl lock map open read watch watch_reads };
allow hardware_rev sysfs_graphics:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow hardware_rev sysfs_i2c_drivers:dir { getattr ioctl lock open read search watch watch_reads };
allow hardware_rev sysfs_i2c_drivers:file { getattr ioctl lock map open read watch watch_reads };
allow hardware_rev sysfs_i2c_drivers:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow hardware_rev sysfs_ram:dir { getattr ioctl lock open read search watch watch_reads };
allow hardware_rev sysfs_ram:file { getattr ioctl lock map open read watch watch_reads };
allow hardware_rev sysfs_ram:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow hardware_rev sysfs_spi_drivers:dir { getattr ioctl lock open read search watch watch_reads };
allow hardware_rev sysfs_spi_drivers:file { getattr ioctl lock map open read watch watch_reads };
allow hardware_rev sysfs_spi_drivers:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow hardware_rev sysfs_storage:dir { getattr ioctl lock open read search watch watch_reads };
allow hardware_rev sysfs_storage:file { getattr ioctl lock map open read watch watch_reads };
allow hardware_rev sysfs_storage:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow hardware_rev sysfs_touchclass:dir { getattr ioctl lock open read search watch watch_reads };
allow hardware_rev sysfs_touchclass:file { getattr ioctl lock map open read watch watch_reads };
allow hardware_rev sysfs_touchscreen:dir { getattr ioctl lock open read search watch watch_reads };
allow hardware_rev sysfs_touchscreen:file { getattr ioctl lock map open read watch watch_reads };
allow hardware_rev sysfs_touchscreen:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow hardware_rev vendor_file:file { execute_no_trans };
allow hardware_rev vendor_shell_exec:file { getattr ioctl lock map open read watch watch_reads };
allow hardware_rev vendor_toolbox_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow init hardware_rev:process transition;
