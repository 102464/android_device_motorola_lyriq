type gnss_daemon, domain;
init_daemon_domain(gnss_daemon)

allow gnss_daemon connsyslog_data_vendor_file:dir { getattr ioctl lock open read search watch watch_reads };
allow gnss_daemon connsyslog_data_vendor_file:file { getattr ioctl lock map open read watch watch_reads };
allow gnss_daemon dnsproxyd_socket:sock_file { write };
allow gnss_daemon factory:unix_dgram_socket { sendto };
allow gnss_daemon fwk_sensor_service:service_manager { find };
allow gnss_daemon fwmarkd_socket:sock_file { write };
allow gnss_daemon gnss_daemon:netlink_kobject_uevent_socket { append bind connect create getattr getopt lock map read setattr setopt shutdown write };
allow gnss_daemon gnss_daemon:tcp_socket { append bind connect create getattr getopt lock map read setattr setopt shutdown write };
allow gnss_daemon gnss_daemon:udp_socket { bind create setattr };
allow gnss_daemon gnss_daemon_exec:file { entrypoint execute getattr map open read };
allow gnss_daemon gnss_data_file:dir { add_name create getattr ioctl lock open read remove_name rename reparent rmdir search setattr watch watch_reads write };
allow gnss_daemon gnss_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow gnss_daemon gps2scp_device:chr_file { append getattr ioctl lock open read watch watch_reads write };
allow gnss_daemon gps_data_file:dir { add_name create getattr ioctl lock open read remove_name rename reparent rmdir search setattr unlink watch watch_reads write };
allow gnss_daemon gps_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow gnss_daemon gps_pwr_device:chr_file { append getattr ioctl lock open read watch watch_reads write };
allow gnss_daemon gps_ticksync_device:chr_file { append getattr ioctl lock open read watch watch_reads write };
allow gnss_daemon hf_manager_device:chr_file { append getattr ioctl lock open read watch watch_reads write };
allow gnss_daemon init:unix_stream_socket { connectto };
allow gnss_daemon metad:unix_dgram_socket { sendto };
allow gnss_daemon hal_gnss_default:unix_dgram_socket { sendto };
allow gnss_daemon mtk_lbs_service:unix_dgram_socket { sendto };
allow gnss_daemon mtk_wwan_device:chr_file { append getattr ioctl lock open read watch watch_reads write };
allow gnss_daemon netd:unix_stream_socket { connectto };
allow gnss_daemon port:tcp_socket { connect name_connect read write };
allow gnss_daemon property_socket:sock_file { write };
allow gnss_daemon servicemanager:binder { call transfer };
allow gnss_daemon sysfs_leds:dir { search };
allow gnss_daemon sysfs_leds:file { getattr ioctl lock open read watch watch_reads };
allow gnss_daemon system_server:binder { call transfer };
allow gnss_daemon system_server:binder { transfer };
allow gnss_daemon system_server:fd { use };
allow gnss_daemon ttyGS_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow gnss_daemon vendor_mtk_mnld_prop:file { getattr map open read };
allow gnss_daemon vendor_mtk_mnld_prop:property_service { set };
allow gnss_daemon vendor_mtk_mnld_vote_prop:file { getattr map open read };
allow gnss_daemon vendor_mtk_mnld_vote_prop:property_service { set };
allow gnss_daemon vendor_mtk_radio_prop:file { getattr map open read };
allow gnss_daemon vendor_mtk_radio_prop:property_service { set };
allow init gnss_daemon:process transition;
