type mtk_hal_mbrain, domain;
init_daemon_domain(mtk_hal_mbrain)

allow init mtk_hal_mbrain:process transition;
allow mtk_hal_mbrain appdomain:dir { getattr ioctl lock open read search watch watch_reads };
allow mtk_hal_mbrain appdomain:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain appdomain:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain binderservicedomain:dir { getattr ioctl lock open read search watch watch_reads };
allow mtk_hal_mbrain binderservicedomain:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain binderservicedomain:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain boot_status_prop:file { getattr map open read };
allow mtk_hal_mbrain data_vendor_mbrain:dir { add_name create getattr ioctl lock open read remove_name rename reparent rmdir search setattr watch watch_reads write };
allow mtk_hal_mbrain data_vendor_mbrain:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow mtk_hal_mbrain debugfs_tracing_instances:dir { add_name create getattr ioctl lock open read remove_name rename reparent rmdir search setattr watch watch_reads write };
allow mtk_hal_mbrain debugfs_tracing_instances:file { append getattr ioctl lock map open read watch watch_reads write };
allow mtk_hal_mbrain domain:dir { getattr ioctl lock open read search watch watch_reads };
allow mtk_hal_mbrain domain:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain domain:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain init:unix_stream_socket { connectto };
allow mtk_hal_mbrain mtk_hal_mbrain_exec:file { entrypoint execute getattr map open read };
allow mtk_hal_mbrain mtk_mbrainj_service:service_manager { find };
allow mtk_hal_mbrain mtk_mbraink_device:chr_file { append getattr ioctl lock open read watch watch_reads write };
allow mtk_hal_mbrain proc_dmaheap:dir { search };
allow mtk_hal_mbrain proc_dmaheap:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain proc_gpu_memory:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain proc_gpufreqv2:dir { search };
allow mtk_hal_mbrain proc_gpufreqv2:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain proc_interrupts:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain proc_meminfo:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain proc_net_tcp_udp:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain proc_power:dir { getattr ioctl lock open read search watch watch_reads };
allow mtk_hal_mbrain proc_power:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain proc_stat:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain proc_swpm:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain proc_timer:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain proc_uid_cputime_showstat:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain proc_uptime:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain proc_vmstat:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain property_socket:sock_file { write };
allow mtk_hal_mbrain self:capability { sys_nice };
allow mtk_hal_mbrain self:netlink_generic_socket { append bind connect create getattr getopt lock map read setattr setopt shutdown write };
allow mtk_hal_mbrain sysfs_batteryinfo:dir { getattr ioctl lock open read search watch watch_reads };
allow mtk_hal_mbrain sysfs_batteryinfo:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain sysfs_cpu_map:dir { getattr ioctl lock open read search watch watch_reads };
allow mtk_hal_mbrain sysfs_fpsgo:dir { search };
allow mtk_hal_mbrain sysfs_fpsgo:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain sysfs_mbraink_gpu:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain sysfs_therm:dir { getattr ioctl lock open read search watch watch_reads };
allow mtk_hal_mbrain sysfs_therm:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain sysfs_thermal_sram:dir { search };
allow mtk_hal_mbrain sysfs_thermal_sram:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain sysfs_wakeup_reasons:dir { getattr ioctl lock open read search watch watch_reads };
allow mtk_hal_mbrain sysfs_wakeup_reasons:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain sysfs_wakeup_reasons:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain sysfs_zram:dir { getattr ioctl lock open read search watch watch_reads };
allow mtk_hal_mbrain sysfs_zram:file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain sysfs_zram:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mbrain vendor_mtk_mbrain_support_prop:file { getattr map open read };
allow mtk_hal_mbrain vendor_mtk_mbrain_support_prop:property_service { set };
