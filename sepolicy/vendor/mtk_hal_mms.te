allow mtk_hal_mms graphics_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow mtk_hal_mms hal_graphics_allocator_default:fd { use };
allow mtk_hal_mms ion_device:chr_file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mms merged_hal_service:fd { use };
allow mtk_hal_mms mtk_cmdq_device:chr_file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mms mtk_hal_mms_exec:file { entrypoint execute getattr map open read };
allow mtk_hal_mms mtk_mdp_device:chr_file { getattr ioctl lock map open read watch watch_reads };
allow mtk_hal_mms mtk_mdp_sync_device:chr_file { getattr ioctl lock map open read watch watch_reads };
