type hal_motsarwifi_default, domain;
init_daemon_domain(hal_motsarwifi_default)

allow hal_motsarwifi_default dumpstate:fd { use };
allow hal_motsarwifi_default dumpstate:fifo_file { write };
allow hal_motsarwifi_default hal_motsarwifi_default_exec:file { entrypoint execute getattr map open read };
allow hal_motsarwifi_default hal_motsarwifi_service:service_manager { add find };
allow hal_motsarwifi_default self:udp_socket { create ioctl };
allow hal_motsarwifi_default servicemanager:binder { call transfer };
allow hal_motsarwifi_default servicemanager:fd { use };
allow init hal_motsarwifi_default:process transition;
