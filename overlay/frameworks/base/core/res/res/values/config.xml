    <item name="config_screenBrightnessSettingDefaultFloat" format="float" type="dimen">0.38189</item>
    <item name="config_screenBrightnessSettingMinimumFloat" format="float" type="dimen">0.034188</item>
    <!-- QPR2 reads min/max as a pair: if MaximumFloat stays at the AOSP default
         (-2=invalid), MinimumFloat is discarded too and both fall back to the
         legacy ints (min 10/255), shifting the whole brightness curve. -->
    <item name="config_screenBrightnessSettingMaximumFloat" format="float" type="dimen">1.0</item>
    <item name="config_screenBrightnessDimFloat" format="float" type="dimen">0.034188</item>
    <integer name="config_screenBrightnessSettingDefault">98</integer>
    <integer name="config_autoBrightnessBrighteningLightDebounce">500</integer>
    <integer name="config_autoBrightnessDarkeningLightDebounce">500</integer>

    <!-- Enable the software navigation bar. AOSP default is false. -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- Enable IMS support at the device level. AOSP defaults are false, which
         makes ImsManager.isVolteEnabledByPlatform() return false and the
         framework actively disable IMS (disableIms) on every boot. -->
    <bool name="config_device_volte_available">true</bool>
    <bool name="config_device_vt_available">true</bool>
    <bool name="config_device_wfc_ims_available">true</bool>

    <!-- The stock ImsService.apk hardcodes stock's compile-time IDs for
         config_device_volte_available (0x01110159) and
         config_device_wfc_ims_available (0x0111015c). On bp1a these IDs resolve
         to the two dreams configs below, whose AOSP defaults are false, so the
         blob decides VoLTE/WFC are unsupported and never sends AT+EIAREG=1;
         IMS PDN never activates and calls fail (logcat-bp1a: ImsConfigUtils
         getBooleanDeviceConfig value=false). Force them true; side effect is
         limited to screen saver (dreams) behaviour. -->
    <bool name="config_dreamsDisabledByAmbientModeSuppressionConfig">true</bool>
    <bool name="config_dreamsOnlyEnabledForDockUser">true</bool>

    <!-- Default to gesture navigation (mode=2). AOSP default is 0 (3-button).
         Without this overlay the device boots into 3-button mode and the edge
         back gesture is inactive (logcat-win-6: NavigationModeController
         mode=0). EdgeBackGestureHandler only activates in gestural mode. -->
    <integer name="config_navBarInteractionMode">2</integer>

    <!-- Give the edge-back gesture a wider activation zone. The MTK touch
         firmware clips the outermost pixels, so the AOSP default inset makes
         edge swipe unreliable/non-functional on this panel. -->
    <dimen name="config_backGestureInset">32dp</dimen>

    <!-- Slot 1 is the eUICC (non-removable). AOSP15 determines eSIM slots via
         this array (UiccSlot.isSlotRemovable); ro.telephony.esim_slot_id is a
         Moto prop not consumed by AOSP. Without it slot 1 is treated as a
         physical SIM slot ("关于本机显示两张实体 SIM 卡"). -->
    <integer-array name="non_removable_euicc_slots">
        <item>1</item>
    </integer-array>

    <!-- The UDFPS vote forces the panel to its max rate (144Hz); the mid-touch
         mode switch glitches the in-cell touch IC and kills the press. Stock
         pins 120Hz during FOD instead. -->
    <bool name="config_ignoreUdfpsVote">true</bool>
</resources>
