<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Panel supports 1080x2400@120 (HWC reports up to 144Hz). AOSP default
         peak is 60Hz, which caps the display at 60FPS (logcat-win-4:
         DisplayModeController falls back to fps=60.00 Hz). -->
    <integer name="config_defaultPeakRefreshRate">120</integer>
    <integer name="config_defaultRefreshRate">120</integer>

    <!-- Anti-flicker: this OLED is visibly dimmer at 60Hz, and the brightness
         jump is perceptible when adaptive refresh drops to 60Hz at low
         brightness. Below these thresholds, lock the panel at 90Hz instead.
         Values from stock MotoFrameworkResOverlayDeviceConfigLyriq.apk. -->
    <integer name="config_defaultRefreshRateInZone">90</integer>
    <integer-array name="config_brightnessThresholdsOfPeakRefreshRate">
        <item>77</item>
        <item>62</item>
    </integer-array>
    <integer-array name="config_ambientThresholdsOfPeakRefreshRate">
        <item>70</item>
        <item>-1</item>
    </integer-array>

    <!-- Doze/AOD. Stock HWC gates doze behind ro.vendor.mtk_aod_support
         (unset on stock = AOD off); framework side mirrors the stock
         auto-generated RROs. -->
    <string name="config_dozeComponent" translatable="false">com.android.systemui/com.android.systemui.doze.DozeService</string>
    <bool name="config_dozeAfterScreenOff">true</bool>
    <bool name="config_dozeAlwaysOnDisplayAvailable">true</bool>
    <bool name="config_dozeAlwaysOnEnabled">false</bool>
    <!-- Lift-to-check pulse: sensors.mt6893.so provides pick_up_gesture
         (stock leaves this off; user-toggleable in ambient display settings) -->
    <bool name="config_dozePulsePickup">true</bool>
    <integer name="config_screenBrightnessDoze">17</integer>
    <bool name="config_powerDecoupleAutoSuspendModeFromDisplay">true</bool>
    <bool name="config_powerDecoupleInteractiveModeFromDisplay">true</bool>
    <string name="config_displayLightSensorType" translatable="false">android.sensor.light</string>

    <!-- Moto Edge Lights: feature flag read by MotoLights via
         Resources.getSystem().getIdentifier; listener package gets
         notification access by default (same mechanism as stock). -->
    <bool name="config_moto_edge_light_supported">true</bool>
    <string name="config_defaultListenerAccessPackages" translatable="false">com.motorola.motolights</string>

    <!-- Panel brightness calibration from stock (same RRO). AOSP default is a
         linear backlight mapping with auto-brightness disabled. -->
    <bool name="config_automatic_brightness_available">true</bool>
    <integer-array name="config_autoBrightnessLevels">
        <item>2</item>
        <item>4</item>
        <item>5</item>
        <item>10</item>
        <item>40</item>
        <item>100</item>
        <item>325</item>
        <item>1250</item>
        <item>3500</item>
        <item>5500</item>
        <item>10000</item>
        <item>50000</item>
        <item>100000</item>
    </integer-array>
    <array name="config_autoBrightnessDisplayValuesNits">
        <item>3</item>
        <item>7</item>
        <item>10</item>
        <item>12</item>
        <item>24</item>
        <item>82</item>
        <item>96</item>
