    </array>
    <integer-array name="config_screenBrightnessBacklight">
        <item>9</item>
        <item>27</item>
        <item>33</item>
        <item>37</item>
        <item>52</item>
        <item>98</item>
        <item>107</item>
        <item>124</item>
        <item>141</item>
        <item>160</item>
        <item>219</item>
        <item>233</item>
        <item>241</item>
        <item>255</item>
    </integer-array>
    <array name="config_screenBrightnessNits">
        <item>3</item>
        <item>7</item>
        <item>10</item>
        <item>12</item>
        <item>24</item>
        <item>95</item>
        <item>111</item>
