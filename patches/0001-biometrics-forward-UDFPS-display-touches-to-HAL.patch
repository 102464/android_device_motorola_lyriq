From 0b4c8229f97f1c11a287f4541f1f7e833baa9004 Mon Sep 17 00:00:00 2001
From: 102464 <pxesrv@outlook.com>
Date: Tue, 4 Aug 2026 18:03:21 +0000
Subject: [PATCH 1/9] biometrics: forward UDFPS display touches to HAL

Stock removes the halHandlesDisplayTouches early-return in
FingerprintProvider.onPointerDown/onPointerUp, so the goodix HAL
receives onPointerDown and can trigger capture. The AOSP drop left
the HAL waiting for a finger event that never arrived, causing
enroll to time out with onError(5).

Change-Id: I5941d6291d53738e03145eb8d590bb045aec4c78
---
 .../sensors/fingerprint/aidl/FingerprintProvider.java     | 8 ++------
 1 file changed, 2 insertions(+), 6 deletions(-)

diff --git a/services/core/java/com/android/server/biometrics/sensors/fingerprint/aidl/FingerprintProvider.java b/services/core/java/com/android/server/biometrics/sensors/fingerprint/aidl/FingerprintProvider.java
index 2dca62903e2e..7d3f7f3182e6 100644
--- a/services/core/java/com/android/server/biometrics/sensors/fingerprint/aidl/FingerprintProvider.java
+++ b/services/core/java/com/android/server/biometrics/sensors/fingerprint/aidl/FingerprintProvider.java
@@ -763,9 +763,7 @@ public class FingerprintProvider implements IBinder.DeathRecipient, ServiceProvi
 
     @Override
     public void onPointerDown(long requestId, int sensorId, PointerContext pc) {
-        if (mFingerprintSensors.get(sensorId).getSensorProperties().halHandlesDisplayTouches) {
-            return;
-        }
+        // lyriq: forward display touches to the HAL (stock behavior)
         mFingerprintSensors.get(sensorId).getScheduler().getCurrentClientIfMatches(
                 requestId, (client) -> {
                     if (!(client instanceof Udfps)) {
@@ -778,9 +776,7 @@ public class FingerprintProvider implements IBinder.DeathRecipient, ServiceProvi
 
     @Override
     public void onPointerUp(long requestId, int sensorId, PointerContext pc) {
-        if (mFingerprintSensors.get(sensorId).getSensorProperties().halHandlesDisplayTouches) {
-            return;
-        }
+        // lyriq: see onPointerDown
         mFingerprintSensors.get(sensorId).getScheduler().getCurrentClientIfMatches(
                 requestId, (client) -> {
                     if (!(client instanceof Udfps)) {
