From 2dc84cd5fa3fabad417ddd634a356350545b9de4 Mon Sep 17 00:00:00 2001
From: 102464 <pxesrv@outlook.com>
Date: Sat, 8 Aug 2026 08:08:40 +0000
Subject: [PATCH 3/9] biometrics: drive FOD directly via Moto panel HAL, opt-in

Replace the property+daemon relay with a direct IDisplayPanel.setMode
binder call from FingerprintProvider, matching stock. Both the touch
forwarding and the HBM toggle are now gated behind
ro.vendor.fod.framework_managed (default false = AOSP behavior), so
other devices are unaffected at build and runtime.

Change-Id: I4ae7163541894db44430c309a9c86ea3dd96581d
---
 .../fingerprint/aidl/FingerprintProvider.java | 50 ++++++++++++++++---
 1 file changed, 44 insertions(+), 6 deletions(-)

diff --git a/services/core/java/com/android/server/biometrics/sensors/fingerprint/aidl/FingerprintProvider.java b/services/core/java/com/android/server/biometrics/sensors/fingerprint/aidl/FingerprintProvider.java
index 1965f28b90c3..7179480b94c3 100644
--- a/services/core/java/com/android/server/biometrics/sensors/fingerprint/aidl/FingerprintProvider.java
+++ b/services/core/java/com/android/server/biometrics/sensors/fingerprint/aidl/FingerprintProvider.java
@@ -49,6 +49,7 @@ import android.os.Binder;
 import android.os.Build;
 import android.os.Handler;
 import android.os.IBinder;
+import android.os.Parcel;
 import android.os.RemoteException;
 import android.os.ServiceManager;
 import android.os.SystemProperties;
@@ -764,7 +765,11 @@ public class FingerprintProvider implements IBinder.DeathRecipient, ServiceProvi
 
     @Override
     public void onPointerDown(long requestId, int sensorId, PointerContext pc) {
-        // lyriq: forward display touches to the HAL (stock behavior)
+        if (!FOD_FRAMEWORK_MANAGED
+                && mFingerprintSensors.get(sensorId).getSensorProperties()
+                        .halHandlesDisplayTouches) {
+            return;
+        }
         setFodHbm(true);
         mFingerprintSensors.get(sensorId).getScheduler().getCurrentClientIfMatches(
                 requestId, (client) -> {
@@ -778,7 +783,11 @@ public class FingerprintProvider implements IBinder.DeathRecipient, ServiceProvi
 
     @Override
     public void onPointerUp(long requestId, int sensorId, PointerContext pc) {
-        // lyriq: see onPointerDown
+        if (!FOD_FRAMEWORK_MANAGED
+                && mFingerprintSensors.get(sensorId).getSensorProperties()
+                        .halHandlesDisplayTouches) {
+            return;
+        }
         setFodHbm(false);
         mFingerprintSensors.get(sensorId).getScheduler().getCurrentClientIfMatches(
                 requestId, (client) -> {
@@ -803,13 +812,42 @@ public class FingerprintProvider implements IBinder.DeathRecipient, ServiceProvi
                 });
     }
 
-    // lyriq: toggle panel HBM through an init property trigger; the goodix
-    // HAL relies on the framework for illumination
+    // lyriq: drive panel HBM directly through the Moto display panel HAL
+    // (stock behavior); the goodix HAL relies on the framework for illumination
+    private static final String PANEL_SERVICE =
+            "com.motorola.hardware.display.panel.IDisplayPanel/default";
+    private static final String PANEL_IFACE =
+            "com.motorola.hardware.display.panel.IDisplayPanel";
+    private static final int TXN_SET_MODE = 5;  // setMode(PanelMode)
+    private static final int PANEL_MODE_NORMAL = 0;
+    private static final int PANEL_MODE_HIGH_BRIGHT_FOD = 4;
+
+    // lyriq: opt-in for devices whose UDFPS HAL needs framework-driven display
+    // touches and illumination; defaults to AOSP behavior elsewhere
+    private static final boolean FOD_FRAMEWORK_MANAGED =
+            SystemProperties.getBoolean("ro.vendor.fod.framework_managed", false);
+
     private void setFodHbm(boolean on) {
+        if (!FOD_FRAMEWORK_MANAGED) {
+            return;
+        }
+        final IBinder panel = ServiceManager.getService(PANEL_SERVICE);
+        if (panel == null) {
+            Slog.e(getTag(), "setFodHbm: panel service unavailable");
+            return;
+        }
+        final Parcel data = Parcel.obtain();
+        final Parcel reply = Parcel.obtain();
         try {
-            SystemProperties.set("vendor.fod.hbm", on ? "1" : "0");
-        } catch (RuntimeException e) {
+            data.writeInterfaceToken(PANEL_IFACE);
+            data.writeInt(on ? PANEL_MODE_HIGH_BRIGHT_FOD : PANEL_MODE_NORMAL);
+            panel.transact(TXN_SET_MODE, data, reply, 0);
+            reply.readException();
+        } catch (RemoteException | RuntimeException e) {
             Slog.e(getTag(), "setFodHbm failed", e);
+        } finally {
+            data.recycle();
+            reply.recycle();
         }
     }
 
